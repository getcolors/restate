#!/usr/bin/env bash
set -euo pipefail
cd /opt/restate
stamp=$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p /var/backups/restate
docker compose stop app restate
trap 'docker compose start restate app' EXIT
tar -C /var/lib -czf "/var/backups/restate/restate-$stamp.tar.gz" restate restate-app
RCLONE_CONFIG_R2_TYPE=s3 \
RCLONE_CONFIG_R2_PROVIDER=Cloudflare \
RCLONE_CONFIG_R2_REGION=auto \
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true \
RCLONE_CONFIG_R2_ACCESS_KEY_ID="$RESTATE_BACKUP_R2_ACCESS_KEY_ID" \
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$RESTATE_BACKUP_R2_SECRET_ACCESS_KEY" \
RCLONE_CONFIG_R2_ENDPOINT="https://319271fed8bc6d2d9059362be1165f37.eu.r2.cloudflarestorage.com" \
rclone copyto "/var/backups/restate/restate-$stamp.tar.gz" \
  "r2:postgres-backup/restate-keygen-fixture/restate-$stamp.tar.gz"
find /var/backups/restate -type f -name 'restate-*.tar.gz' -mtime +7 -delete
